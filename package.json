{
  "name": "municipal-agents",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/main.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/main.ts",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"agents/**/*.test.ts\" \"lenses/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sources": "node scripts/sources.ts",
    "smoke": "node scripts/smoke.ts",
    "deploy": "fly deploy --remote-only && npm run smoke"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
