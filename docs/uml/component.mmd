%% Component diagram (core): the parts that turn documents into a checked brief and answers.
%% server/, agents/, lenses/ and shared/ run in one Node 24 process on one machine.
%% The public-facing platform pieces (landing, docs, embed, feeds) are in component-platform.mmd.
flowchart TB
  web["<b>Resident and staff app</b> (web/)<br/>Preact · Vite · MapLibre · pdf.js<br/>Brief · lenses · source viewer · Ask<br/>Staff review · Record (chain check) · Spend"]
  tiles["OpenFreeMap<br/>map tiles"]

  subgraph server["server/"]
    s1["http.ts<br/>router + SSE"]
    s4["Staff auth<br/>(bearer passcode)"]
    s2["routes/<br/>public · agents · staff"]
    s6["limits.ts + usage.ts<br/>rate limit, run slots,<br/>daily spend cap"]
    s7["runfiles.ts<br/>saved runs = answer cache"]
    s8["statements.ts<br/>review rules, re-check<br/>(verify.ts), public brief"]
    s5["log.ts<br/>node:sqlite, SHA-256 chain"]
  end

  subgraph agents["agents/"]
    a1["lead.ts<br/>plan, merge, ground"]
    a2["loop.ts + skills/*/SKILL.md<br/>explainer · transit-access · lifecycle-cost<br/>commitments · housing-pipeline<br/>construction-scout · translator"]
    a3["tools.ts<br/>search_pages (BM25) · read_page<br/>record_statement · record_computed_figure<br/>lens tools"]
    a7["offline.ts<br/>answers from the checked<br/>brief, no model"]
    a6["gemini.ts<br/>REST client"]
  end

  subgraph shared["shared/ (also runs in the browser)"]
    v1["verify.ts<br/>citation checker"]
    v2["readability.ts<br/>reading grade"]
  end

  subgraph lenses["lenses/ (build scripts + summaries)"]
    direction LR
    l1["transit<br/>Connection Scan"]
    l2["cost<br/>lifecycle"]
    l3["commitments<br/>status"]
    l4["housing<br/>pipeline"]
    l5["construction<br/>scout · layout · steps"]
  end

  subgraph data["Files: data/ and cities/"]
    direction LR
    d1[("sources/<br/>PDFs + page text")]
    d2[("decisions/<br/>briefs/")]
    d6[("lenses/<br/>precomputed results")]
    d7[("runs/<br/>every run's events")]
    d8[("renders/<br/>step illustrations")]
    d5[("cities/<br/>city config")]
  end

  gem["Gemini API"]

  web -- "HTTPS: JSON + SSE" --> s1
  web -. "tiles" .-> tiles
  s1 --> s4 --> s2
  s2 --> s6 --> s5
  s2 -- "same question?" --> s7
  s2 --> s8
  s2 --> a1
  a1 --> a2 --> a3
  a1 -- "model unreachable" --> a7
  a1 & a2 --> a6
  a6 -- "function calling" --> gem
  a3 -- "every quote" --> v1
  a1 -- "grade" --> v2
  a3 -- "statement.recorded / rejected" --> s5
  a3 -- "summaries, status,<br/>cost maths" --> lenses
  a3 --> d1
  a3 --> d6
  a7 --> d2
  s7 --> d7
  s2 --> d2 & d5 & d8
  lenses -- "build scripts write" --> d6

  classDef ext fill:#f2f2f2,stroke:#777,color:#111
  classDef file fill:#fffaf0,stroke:#b8860b,color:#111
  class gem,tiles ext
  class d1,d2,d5,d6,d7,d8 file
